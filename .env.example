# AliExpress Open Platform Application Credentials
# Obtain these from: https://open.aliexpress.com/ -> App Console
ALIEXPRESS_APP_KEY=your_app_key_here
ALIEXPRESS_APP_SECRET=your_app_secret_here

# OAuth Redirect URI configured in your AliExpress Developer Console
# Example for local development:
ALIEXPRESS_REDIRECT_URI=http://localhost:3000/api/aliexpress/auth/callback

# Optional: Access token can be provided directly or obtained automatically via the OAuth flow.
# When the OAuth flow is completed, tokens are automatically persisted to .token.json.
ALIEXPRESS_ACCESS_TOKEN=

# Server Port (default: 3000)
PORT=3000
