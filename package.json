{
  "name": "ae-order-poc",
  "version": "1.0.0",
  "description": "AliExpress Dropshipping Integration - Get Item by ID API and OAuth Authentication Flow",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "get-item": "tsx src/cli.ts get-item",
    "aliexpress:orders": "tsx src/cli.ts list-orders",
    "aliexpress:order": "tsx src/cli.ts get-order",
    "auth:url": "tsx src/cli.ts auth-url",
    "auth:token": "tsx src/cli.ts exchange",
    "test": "vitest run"
  },
  "keywords": [
    "aliexpress",
    "dropshipping",
    "oauth",
    "api",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
